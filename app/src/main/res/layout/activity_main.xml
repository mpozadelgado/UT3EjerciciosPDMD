<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="UT3 · Ejercicios evaluables"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnEj1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 1 · URL" />

    <Button
        android:id="@+id/btnEj2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 2 · Navegación retrasada" />

    <Button
        android:id="@+id/btnEj3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 3 · LinearLayout" />

    <Button
        android:id="@+id/btnEj4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 4 · FrameLayout" />

    <Button
        android:id="@+id/btnEj5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 5 · Calculadora" />

    <Button
        android:id="@+id/btnEj6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 6 · Perfil" />

</LinearLayout>